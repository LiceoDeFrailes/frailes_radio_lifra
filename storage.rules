rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Estudiantes pueden subir noticias
    match /noticias/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
                   request.auth.uid == userId &&
                   firestore.get(
                     /databases/(default)/documents/usuarios/$(request.auth.uid)
                   ).data.role == "estudiante";
      allow delete: if request.auth != null &&
                    firestore.get(
                      /databases/(default)/documents/usuarios/$(request.auth.uid)
                    ).data.role == "admin";
    }
    
    // Estudiantes pueden subir galerias
    match /galerias/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
                   request.auth.uid == userId &&
                   firestore.get(
                     /databases/(default)/documents/usuarios/$(request.auth.uid)
                   ).data.role == "estudiante";
      allow delete: if request.auth != null &&
                    firestore.get(
                      /databases/(default)/documents/usuarios/$(request.auth.uid)
                    ).data.role == "admin";
    }
    
    // Solo admins pueden subir la foto grupal del equipo
    match /equipo/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
                   firestore.get(
                     /databases/(default)/documents/usuarios/$(request.auth.uid)
                   ).data.role == "admin" &&
                   request.resource.size < 3 * 1024 * 1024 &&
                   request.resource.contentType.matches('image/.*');
    }
    
  }
}
